@using PetSitterApp.Models
@using PetSitterApp.Services
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mr-8">
            <MudText Typo="Typo.h6">Payments for @MonthLabel</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Info" Size="Size.Small" OnClick="ShowInfo" title="How is this calculated?" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudTable Items="@Payments" Hover="true" Breakpoint="Breakpoint.None" Elevation="0">
            <HeaderContent>
                <MudTh>Paid Date</MudTh>
                <MudTh>Details</MudTh>
                <MudTh>Amount</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Paid Date">@context.PaymentDate.ToString("d")</MudTd>
                <MudTd DataLabel="Details">@GetDetails(context)</MudTd>
                <MudTd DataLabel="Amount">@context.Amount.ToString("C")</MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<PaymentBreakdownItem> Payments { get; set; } = new();
    [Parameter] public string MonthLabel { get; set; } = "";

    public class PaymentBreakdownItem
    {
        public DateTime PaymentDate { get; set; }
        public string CustomerName { get; set; } = "";
        public string PetNames { get; set; } = "";
        public double Amount { get; set; }
        public DateTime? AppointmentStart { get; set; }
        public DateTime? AppointmentEnd { get; set; }
    }

    private void Close()
    {
        MudDialog.Close(DialogResult.Ok(true));
    }

    private async Task ShowInfo()
    {
        await DialogService.ShowMessageBoxAsync(
            "Calculation Info",
            "The end date of the visit is used to factor in the amount paid for the month.",
            yesText: "OK");
    }

    private string GetDetails(PaymentBreakdownItem item)
    {
        var who = string.IsNullOrWhiteSpace(item.PetNames)
            ? item.CustomerName
            : $"{item.CustomerName} ({item.PetNames})";

        if (item.AppointmentStart == null || item.AppointmentEnd == null)
        {
            return who;
        }

        var start = item.AppointmentStart.Value;
        var end = item.AppointmentEnd.Value;

        string dateString = "";
        if (start.Date == end.Date)
        {
            dateString = $"{start.ToString("d")} (1 day)";
        }
        else
        {
            var nights = (end.Date - start.Date).Days;
            string nightStr = nights == 1 ? "1 night" : $"{nights} nights";
            dateString = $"{start.ToString("d")} to {end.ToString("d")} ({nightStr})";
        }

        return $"{who} - {dateString}";
    }
}
